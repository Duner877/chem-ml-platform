{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chem-ml-platform/datasets/metadata.schema.json",
  "title": "Chem ML Platform dataset metadata",
  "description": "v0.7.1 task G metadata schema. One record per dataset; validated by data_layer.quality and scripts/dataset_governance.py.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "family",
    "data_type",
    "format",
    "license",
    "source",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "description": "Human readable dataset name."
    },
    "family": {
      "type": "string",
      "description": "Must equal the directory directly under datasets/.",
      "enum": [
        "demo",
        "nmr",
        "xrd",
        "spectroscopy",
        "microscopy",
        "mass_spectrometry"
      ]
    },
    "data_type": {
      "type": "string",
      "description": "Scientific object type produced by the parser.",
      "enum": [
        "Table",
        "MassSpectrum",
        "NMRSpectrum",
        "IRSpectrum",
        "UVVisSpectrum",
        "RamanSpectrum",
        "NIRSpectrum",
        "XRDPattern",
        "SEMImage",
        "TEMImage",
        "MicroscopyImage",
        "AFMImage"
      ]
    },
    "technique": {
      "type": "string",
      "description": "Acquisition technique, e.g. 'FT-IR transmittance'."
    },
    "sample": { "type": "string" },
    "vendor": { "type": "string" },
    "instrument": { "type": "string" },
    "format": {
      "type": "string",
      "description": "Container format label, e.g. 'JCAMP-DX', 'Galactic SPC'."
    },
    "x_unit": { "type": "string" },
    "y_unit": { "type": "string" },
    "points": { "type": "integer", "minimum": 1 },
    "x_range": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 date the record was created."
    },
    "license": {
      "type": "string",
      "description": "Distribution terms, e.g. 'CC0 (generated by the platform)'."
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["synthetic", "public", "vendor"] },
        "generator": { "type": "string" },
        "reference": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "description": "Payload files with content digest, for traceability.",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
