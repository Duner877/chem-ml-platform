# Build-context exclusions for the Chem ML Platform image.
# Keep the build context (repository root) lean and free of local artefacts.

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Node / frontend
frontend/node_modules/
frontend/dist/
npm-debug.log*

# Runtime output & local state (generated at runtime, not baked into the image)
output/
memory/
*.log

# Version control & CI
.git/
.github/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local dataset overrides that should not ship (keep the curated set only)
datasets/raw/
*.tmp
