{
  "name": "chemml-desktop",
  "productName": "Chem ML Platform",
  "version": "0.7.2",
  "description": "Chem ML Platform v0.7.2 -- Desktop Scientific AI OS (Electron shell)",
  "main": "src/main.js",
  "author": "Chem ML Platform contributors",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64 -c.win.signAndEditExecutable=false",
    "build:dir": "electron-builder --dir",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.chemml.platform",
    "productName": "Chem ML Platform",
    "directories": {
      "output": "dist"
    },
    "beforeBuild": "./scripts/stamp-build-info.js",
    "files": [
      "src/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "app/frontend/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../backend",
        "to": "app/backend",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../nodes",
        "to": "app/nodes",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../workflow_engine",
        "to": "app/workflow_engine",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../simulations",
        "to": "app/simulations",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../models",
        "to": "app/models",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../foundation",
        "to": "app/foundation",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../ai_runtime",
        "to": "app/ai_runtime",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../data_layer",
        "to": "app/data_layer",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../simulation_runtime",
        "to": "app/simulation_runtime",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../database_runtime",
        "to": "app/database_runtime",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../databases",
        "to": "app/databases",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../provenance",
        "to": "app/provenance",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../storage",
        "to": "app/storage",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../report_agent",
        "to": "app/report_agent",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../report_engine",
        "to": "app/report_engine",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../agent_runtime",
        "to": "app/agent_runtime",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../node_registry",
        "to": "app/node_registry",
        "filter": ["**/*.py", "**/*.json", "!**/__pycache__/**"]
      },
      {
        "from": "../memory",
        "to": "app/memory",
        "filter": ["**/*.py", "!**/__pycache__/**"]
      },
      {
        "from": "../config",
        "to": "app/config",
        "filter": ["*.json"]
      },
      {
        "from": "../plugins",
        "to": "app/plugins",
        "filter": ["**/*"]
      },
      {
        "from": "../datasets",
        "to": "app/datasets",
        "filter": ["**/*"]
      },
      {
        "from": "../workflows",
        "to": "app/workflows",
        "filter": ["**/*"]
      },
      {
        "from": "../chemml_version.py",
        "to": "app/chemml_version.py"
      },
      {
        "from": "../BUILD_INFO.json",
        "to": "app/BUILD_INFO.json"
      },
      {
        "from": "../requirements.txt",
        "to": "app/requirements.txt"
      },
      {
        "from": "resources/python-runtime",
        "to": "python-runtime",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Science"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    }
  }
}
