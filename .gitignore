# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
*.egg-link
.venv/
venv/
ENV/
env/

# ---- Testing / coverage ----
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# ---- Local single-port static junction (created by start-platform.bat) ----
static/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Runtime output ----
output/
!output/.gitkeep
artifacts/
*.log

# ---- Upload workspace (runtime state, same policy as output/) ----
# v0.7.2 fix (ISSUE-19): workspace/raw_data/x.csv, a test fixture left behind by
# an earlier smoke run, had been committed and shipped in the source archive.
workspace/*
!workspace/.gitkeep

# ---- Agent runtime memory (accumulated state, regenerated on demand) ----
memory/*.json

# ---- Local configuration / secrets ----
.env
.env.*
!.env.example
*.local
config/ai.json
!config/.gitkeep
!config/ai.example.json
plugins/*
!plugins/.gitkeep
!examples/

# ---- Models / caches ----
*.pt
*.pth
*.ckpt
*.h5
*.onnx
.cache/
hf_cache/

# ---- Archives ----
*.zip
*.tar.gz

# ---- Vite config-loader temp files ----
# vite writes vite.config.ts.timestamp-<ms>-<hash>.mjs next to the config while
# bundling it; on hosts where unlink is restricted it lingers after the build.
frontend/vite.config.*.timestamp-*.mjs
frontend/vite.config.ts.timestamp-*
