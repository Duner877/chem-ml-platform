# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# ---- Local single-port static junction (created by start-platform.bat) ----
static/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Runtime output ----
output/
!output/.gitkeep
artifacts/
*.log

# ---- Local scratch space ----------------------------------------------------
# Temporary test fixtures and scratch files.  It must be listed here: the
# release scanners treat anything *not* covered by .gitignore as a real
# artefact of the tree, so a stray ``--basetemp=.tmp/...`` run would make
# the credential scanner report the fixtures it created as leaked secrets.
# The same files also showed up as untracked noise in ``git status``.
.tmp/

# ---- Upload workspace (runtime state, same policy as output/) ----
# v0.7.2 fix (ISSUE-19): workspace/raw_data/x.csv, a test fixture left behind by
# an earlier smoke run, had been committed and shipped in the source archive.
workspace/*
!workspace/.gitkeep

# ---- Agent runtime memory (accumulated state, regenerated on demand) ----
memory/*.json

# ---- Local configuration / secrets ----
.env
.env.*
!.env.example
*.local
config/ai.json
config/credentials.json
# v0.7.3: the desktop launcher drops the live session token here.  It was
# never listed, so it was only protected from the archive by accident.
config/session.json
!config/.gitkeep
!config/ai.example.json
plugins/*
!plugins/.gitkeep
!examples/

# ---- Models / caches ----
*.pt
*.pth
*.ckpt
*.h5
*.onnx
.cache/
hf_cache/

# ---- Archives ----
*.zip
*.tar.gz

# ---- Build stamp (generated by the desktop beforeBuild hook; injected into
# the source archive by scripts/package.py instead of being walked in) ----
BUILD_INFO.json

# ---- Vite config-loader temp files ----
# vite writes vite.config.ts.timestamp-<ms>-<hash>.mjs next to the config while
# bundling it; on hosts where unlink is restricted it lingers after the build.
frontend/vite.config.*.timestamp-*.mjs
frontend/vite.config.ts.timestamp-*
